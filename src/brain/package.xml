<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>brain</name>
  <version>0.0.0</version>
  <description>Brain node for K1DIY based on NaovaK1</description>
  <maintainer email="le-khai.pham.1@ens.etsmtl.ca">Khai Pham</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>

  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <depend>vision_interface</depend>
  <depend>opencv</depend>
  <depend>booster_msgs</depend>
  <depend>booster_interface</depend>
  <depend>game_controller_interface</depend>

  <depend>behaviortree_cpp</depend>
  <depend>yaml-cpp</depend>
  <depend>eigen</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>